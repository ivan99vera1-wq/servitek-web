# SERVITEK - Variables de entorno
# Copiar a .env.local para desarrollo, o definirlas en Cloudflare Pages.

# URL canónica del sitio. Sin dominio propio todavía: dejar vacía para usar el
# valor por defecto, o apuntar al subdominio de Cloudflare Pages.
# Cuando se compre el dominio, cambiar aquí y en Cloudflare. NO escribir el
# dominio a mano en el código: se lee desde src/lib/site.ts y site.config.js.
NEXT_PUBLIC_SITE_URL=

# Indexación en buscadores. Mantener sin definir (o "false") hasta que el
# dominio definitivo esté conectado y el contenido real publicado.
# Con "false" el sitio emite noindex y robots.txt bloquea el rastreo.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Google Analytics 4 (opcional).
# ATENCIÓN: activarlo instala cookies -> exige banner de consentimiento y
# política de cookies redactada. Hoy el sitio no instala ninguna cookie.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
